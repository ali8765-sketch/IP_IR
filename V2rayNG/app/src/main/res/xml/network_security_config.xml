<?xml version="1.0" encoding="utf-8"?>
<!-- Chapar: HTTPS only, and only the system's certificate authorities (no user-installed CAs). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
